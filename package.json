{
  "name": "trimptennis",
  "version": "1.0.0",
  "private": true,
  "description": "Seahawks Tennis Academy — static site + enrollment API on one Cloudflare Worker",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run check:programs && wrangler deploy",
    "images": "node scripts/optimize-images.mjs",
    "check:programs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-programs.mjs",
    "check:prices": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-prices.mjs",
    "db:schema": "wrangler d1 execute trimptennis-db --remote --file=./schema.sql",
    "db:schema:local": "wrangler d1 execute trimptennis-db --local --file=./schema.sql",
    "test:account": "node scripts/test-account.mjs",
    "test:enroll": "node scripts/test-enroll-link.mjs",
    "test:payurl": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-payurl.mjs",
    "test:links": "node scripts/test-links.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "sharp": "^0.35.3",
    "typescript": "^5.5.0",
    "wrangler": "^4.0.0"
  }
}
